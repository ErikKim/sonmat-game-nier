  },
  "pod_laser_charge": {
   "match": "^wp3000_lazer_charge$",
   "until": "^stop_wp3000_lazer_charge$|^wp3000_lazer_shot",
   "pad": "R2",
   "effect": "vibrate",
   "start": 2,
   "amp": 1,
   "hz": 15,
   "hold": 8,
   "stages": [[1.0, {"amp": 2}], [2.0, {"amp": 3}]],
   "held": ["r2"]
  },
  "pod_laser_fire": {
   "match": "^wp3000_lazer_shot(_lv[234])?$",
   "pad": "R2",
   "effect": "vibrate",
   "amp": 7,
   "hz": 30,
   "hold": 0.22,
   "held": ["r2"]
  },
  "pod_laser": {
   "match": "^wp3000_lazer_shot_lv\\d_loop$",
   "until": "^Stop_wp3000_lazer_shot_lv\\d_loop$",
   "pad": "R2",
   "effect": "vibrate",
   "amp": 3,
   "hz": 20,
   "hold": 10,
   "held": ["r2"]
  },
  "pod_missile": {
   "match": "^wp3000_missile_shot_lv\\d$",
   "pad": "R2",
   "effect": "vibrate",
   "amp": 8,
   "hz": 6,
   "hold": 0.22,
   "held": ["r2"]
  },
  "just_evade": {
   "match": "^pl\\d+_just_avoid|^core_pl_avoidance$",
