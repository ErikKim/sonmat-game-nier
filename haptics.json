   "match": "^core_pl_AS_(black_spear_shot|small_bom_shot|wire_shot|pod_throw_wsh|pod_throw_ring_laser_shot|barrier_start|black_Whirling_start|black_hand_gene|black_gluttony_start|black_illusion_lv\\d|black_exec_start|gravity_bom_loop_lv\\d|slow_bom_loop_lv\\d|hologram_loop|body_recovery_loop|pod_ride_start)$",
